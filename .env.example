# Supabase API Credentials Configuration
# Copy this file to '.env' and fill in your project credentials.

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Gemini API Key (Server-Side Only - never exposed to browser)
# For local development, place in .env as GEMINI_API_KEY.
# For Vercel deployment, configure as an Environment Variable in Vercel Project Settings.
GEMINI_API_KEY=your_gemini_api_key_here
